<!DOCTYPE html>
<html lang="en">

<head>
    <title>Retailer Sign In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#27235D">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="PINGAKSH">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=3">
</head>

<body class="view-login">
    <div class="ambient"></div>
    <div class="grain"></div>

    <div class="app login-app">
        <main class="login-stage">
            <section class="login-card">
                <div class="login-card-head">
                    <p class="mode-kicker">Retailer Access</p>
                    <h1 class="login-title">Sign In</h1>
                    <p class="login-desc">Enter your registered mobile number and PIN to verify tags and access certified pieces.</p>
                </div>

                <div id="loginAlert" class="login-alert" hidden>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="alert-icon">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span id="loginAlertText">Invalid credentials</span>
                </div>

                <form id="loginForm" class="login-form" autocomplete="on">
                    <div class="form-group">
                        <label for="mobileInput" class="form-label">Mobile Number</label>
                        <div class="mobile-input-shell">
                            <span class="mobile-prefix">+91</span>
                            <input
                                id="mobileInput"
                                name="mobile"
                                type="tel"
                                inputmode="numeric"
                                maxlength="10"
                                placeholder="98765 43210"
                                autocomplete="tel-national"
                                required
                            />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="pinInput" class="form-label">Security PIN</label>
                        <div class="pin-input-shell">
                            <input
                                id="pinInput"
                                name="pin"
                                type="password"
                                inputmode="numeric"
                                maxlength="10"
                                placeholder="Enter PIN"
                                autocomplete="current-password"
                                required
                            />
                            <button type="button" id="togglePinBtn" class="pin-toggle-btn" aria-label="Toggle PIN visibility">
                                <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="eyeOffIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden>
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="gold-btn login-btn">
                        <span class="btn-text">Sign In</span>
                        <span class="btn-spinner" hidden></span>
                    </button>
                </form>

                <p class="login-footer-copy">Secure retailer session</p>
            </section>
        </main>
    </div>

    <script>
        (function() {
            const form = document.getElementById("loginForm");
            const mobileInput = document.getElementById("mobileInput");
            const pinInput = document.getElementById("pinInput");
            const submitBtn = document.getElementById("submitBtn");
            const btnText = submitBtn.querySelector(".btn-text");
            const btnSpinner = submitBtn.querySelector(".btn-spinner");
            const alertBox = document.getElementById("loginAlert");
            const alertText = document.getElementById("loginAlertText");
            const togglePinBtn = document.getElementById("togglePinBtn");
            const eyeIcon = document.getElementById("eyeIcon");
            const eyeOffIcon = document.getElementById("eyeOffIcon");

            // Allow only numbers in mobile input
            mobileInput.addEventListener("input", () => {
                mobileInput.value = mobileInput.value.replace(/[^0-9]/g, "").slice(0, 10);
            });

            // Toggle PIN visibility
            togglePinBtn.addEventListener("click", () => {
                const isPassword = pinInput.type === "password";
                pinInput.type = isPassword ? "text" : "password";
                eyeIcon.hidden = isPassword;
                eyeOffIcon.hidden = !isPassword;
            });

            const showAlert = (msg) => {
                alertText.textContent = msg;
                alertBox.hidden = false;
                alertBox.classList.remove("is-shaking");
                void alertBox.offsetWidth;
                alertBox.classList.add("is-shaking");
            };

            const hideAlert = () => {
                alertBox.hidden = true;
            };

            const setLoading = (loading) => {
                submitBtn.disabled = loading;
                btnText.textContent = loading ? "Signing in…" : "Sign In";
                btnSpinner.hidden = !loading;
            };

            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                hideAlert();

                const rawMobile = mobileInput.value.trim();
                const pin = pinInput.value.trim();

                if (!rawMobile || rawMobile.length < 10) {
                    showAlert("Please enter a valid 10-digit mobile number.");
                    mobileInput.focus();
                    return;
                }

                if (!pin) {
                    showAlert("Please enter your PIN.");
                    pinInput.focus();
                    return;
                }

                const fullMobile = "+91" + rawMobile;
                setLoading(true);

                try {
                    const res = await fetch("/api/login", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json",
                        },
                        body: JSON.stringify({
                            mobile: fullMobile,
                            pin: pin,
                        }),
                    });

                    const data = await res.json();

                    if (res.ok && data.success) {
                        btnText.textContent = "Redirecting…";
                        window.location.href = data.redirect || "/";
                        return;
                    }

                    showAlert(data.message || "Invalid mobile number or PIN.");
                } catch (err) {
                    showAlert("Could not connect to authentication service. Please check your network.");
                } finally {
                    setLoading(false);
                }
            });
        })();
    </script>
</body>

</html>
